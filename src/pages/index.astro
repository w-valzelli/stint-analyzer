---
import AnalyzerShell from '../components/AnalyzerShell';
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Stint Analyzer reviews Garage 61 stint exports locally in your browser."
    />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${baseUrl}favicon-32x32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${baseUrl}favicon-16x16.png`}
    />
    <link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <title>Stint Analyzer</title>
    <script is:inline>
      (() => {
        const storageKey = 'stint-analyzer-theme';
        let preference = 'system';

        try {
          const stored = window.localStorage.getItem(storageKey);
          if (stored === 'light' || stored === 'dark' || stored === 'system') {
            preference = stored;
          }
        } catch {
          // Storage can be unavailable in private or restricted browser contexts.
        }

        const followsDark =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          preference === 'dark' || (preference === 'system' && followsDark) ? 'dark' : 'light';

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <!--
    THESIS: Make source review and lap evidence direct instead of decorative.
    OWN-WORLD: Mineral paper, graphite ink, cobalt marks, ruled data, paper texture, and useful state icons form a working record.
    STORY: The visitor adds Garage 61 files, reviews source facts, and moves into analysis views.
    FIRST VIEWPORT: A direct Stint Analyzer wordmark leads to the source card, readouts, import rows, and detected-lap table; theme control stays in the header.
    FORM: Matter-of-fact Working Record, extension of Calibration Ledger direction, seed key 7c2a91e4.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <AnalyzerShell client:load />
  </body>
</html>
